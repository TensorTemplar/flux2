# FLUX.2 Configuration
# Copy to .env and fill in your values

# HuggingFace cache directory (required for container, optional locally)
# HF_HOME=/mnt/terradump/nns/huggingface

# Model selection
MODEL_NAME=flux.2-klein-base-4b

# Enable content moderation (loads Mistral-24B, adds ~50GB)
ENABLE_MODERATION=false

# Prompt upsampling mode: none, local, or api
UPSAMPLE_PROMPT_MODE=none

# OpenAI-compatible API for prompt upsampling (when UPSAMPLE_PROMPT_MODE=api)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://my-openai-compatible-api-example.tld
OPENAI_MODEL=gpt-oss-120b
